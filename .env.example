# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string. For the Postgres 18 server already running on
# this machine, create the database first:
#   psql -U postgres -c "CREATE DATABASE peragibbs;"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/peragibbs?schema=public"

# Optional: the production connection string, kept here so you can run
# migrations and the seed against production without editing DATABASE_URL.
# An inline override wins over this file, so target production per command:
#   DATABASE_URL="$PROD_DATABASE_URL" npx prisma db seed
# On Neon, run MIGRATIONS against the direct endpoint (drop "-pooler" from the
# host); the pooled endpoint is for the running app.
PROD_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------
# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Used by the seed script to create (or reset) the first admin user.
ADMIN_EMAIL="admin@peragibbsmovement.com"
ADMIN_NAME="Pera Gibbs"
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# From https://resend.com/api-keys. Leave empty in development: submissions are
# still stored, and the admin panel shows the notification as "skipped".
RESEND_API_KEY=""

# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Pera Gibbs Movement <noreply@peragibbsmovement.com>"

# Where enquiry notifications are delivered.
CONTACT_TO_EMAIL="admin@peragibbsmovement.com"

# Set to "false" to stop sending the visitor an acknowledgement email.
CONTACT_AUTOREPLY="true"
